# Flask Configuration
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-another-random-secret-key

# Database Configuration
# SQLite (default for development)
DB_URL=sqlite://storage.db

# PostgreSQL (recommended for production)
# DB_URL=postgresql://username:password@localhost:5432/squawk_manager

# MySQL
# DB_URL=mysql://username:password@localhost:3306/squawk_manager

# Redis/Valkey for caching and rate limiting
REDIS_URL=redis://localhost:6379
VALKEY_URL=redis://localhost:6379

# Cache Configuration
CACHE_TTL=300

# Rate Limiting
RATELIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/hour

# Server Configuration
MAX_WORKERS=4
MAX_CONCURRENT_REQUESTS=1000

# mTLS Configuration
ENABLE_MTLS=false

# License Configuration (optional)
USE_LICENSE_SERVER=false
LICENSE_SERVER_URL=https://license.squawkdns.com
PENGUINTECH_LICENSE_KEY=

# gRPC Configuration
GRPC_PORT=50051
