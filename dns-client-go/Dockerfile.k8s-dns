FROM golang:1.24-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG GIT_COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X 'main.version=${VERSION}' -X 'main.gitCommit=${GIT_COMMIT}'" \
    -o bin/squawk-k8s-dns \
    ./cmd/squawk-k8s-dns

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd -r squawk && useradd -r -g squawk -u 1000 squawk
COPY --from=builder /app/bin/squawk-k8s-dns /usr/local/bin/squawk-k8s-dns
USER squawk
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD squawk-k8s-dns healthz || exit 1
ENTRYPOINT ["squawk-k8s-dns"]
CMD ["serve"]

LABEL org.opencontainers.image.title="Squawk K8s DNS"
LABEL org.opencontainers.image.description="Kubernetes-aware DNS server bridging cluster.local with DoH"
LABEL org.opencontainers.image.vendor="PenguinTech Group"
