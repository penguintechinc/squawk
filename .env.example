# Database
DB_PASSWORD=changeme
DB_URL=postgresql://squawk:changeme@postgres:5432/squawk_manager

# Security
JWT_SECRET_KEY=your-jwt-secret-key-change-this
SECRET_KEY=your-app-secret-key-change-this

# DNS Server Join Keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
DNS_SERVER_1_JOIN_KEY=
DNS_SERVER_2_JOIN_KEY=

# License (optional)
PENGUINTECH_LICENSE_KEY=

# Redis
REDIS_URL=redis://valkey:6379

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# PostgreSQL (for enterprise features)
POSTGRES_PASSWORD=changeme

# DNS Server Auth Token (for legacy single-token mode)
AUTH_TOKEN=
