FROM debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d AS base

RUN apt-get update && apt-get install -y software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y \
    python3.13 python3.13-venv python3.13-dev \
    build-essential && \
    apt-get clean

FROM base AS dns-server
WORKDIR /app

# Copy requirements
COPY requirements-dns-server.txt /app/

# Create virtual environment and install dependencies
RUN python3.13 -m venv /app/venv && \
    /app/venv/bin/pip install --upgrade pip && \
    /app/venv/bin/pip install -r requirements-dns-server.txt

# Set PATH to use venv
ENV PATH="/app/venv/bin:$PATH"

# Copy application code
COPY app/ /app/app/
COPY protos/ /app/protos/

# Create cache directory
RUN mkdir -p /app/cache

# Create non-root user and set ownership
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app

USER appuser

# Expose ports
EXPOSE 8080 50052 53/udp 53/tcp

# NOTE: K8s securityContext requires: capabilities.add: [NET_BIND_SERVICE]
# This allows non-root binding to port 53
CMD ["python", "-m", "app.main"]
